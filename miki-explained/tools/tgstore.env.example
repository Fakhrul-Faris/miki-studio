# Copy to ~/.config/telegram/tgstore.env and chmod 600. Never commit the real file or the token.
# The bot token lives in its own file (one line, nothing else):
TG_TOKEN_FILE=~/.config/telegram/meikigoBot.token
# The storage chat: your private chat with the bot (send it /start, then: tgstore.py find-chat).
TG_CHAT_ID=123456789
# Cloud Bot API (50 MB up / 20 MB down) until the local server runs; then switch both lines below:
TG_API_BASE=https://api.telegram.org
# TG_API_BASE=http://127.0.0.1:8081
# TG_LOCAL_DATA=~/Private/telegram-bot-api/data
